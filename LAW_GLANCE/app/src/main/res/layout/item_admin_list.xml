<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#0F0F15">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/card_border_dark">

        <!-- Top Row: Avatar, Title + Status Pill, Options Dots Menu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Avatar Circle -->
            <androidx.cardview.widget.CardView
                android:id="@+id/adminAvatarCard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2A1B0A">
                
                <TextView
                    android:id="@+id/tvAdminItemAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="#FF8C00"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </androidx.cardview.widget.CardView>

            <!-- Info Block (Title & Specialization) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/adminAvatarCard"
                android:layout_toStartOf="@+id/btnAdminItemMenu"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true">

                <!-- Title & Status Badge Horizontal Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvAdminItemTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Adv. abc"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1"/>

                    <TextView
                        android:id="@+id/tvAdminItemStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="APPROVED"
                        android:textColor="#30D158"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/badge_accepted"
                        android:singleLine="true"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAdminItemSub2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Criminal Specialization"
                    android:textColor="#FF8C00"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"/>
            </LinearLayout>

            <!-- Options Ellipsis Menu Icon -->
            <ImageView
                android:id="@+id/btnAdminItemMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_dots_vector"
                android:padding="6dp"
                android:contentDescription="More Actions"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </RelativeLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E3E"
            android:layout_marginBottom="12dp"/>

        <!-- Details Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <!-- Email Detail Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_mail_vector"
                    android:contentDescription="Email Icon"
                    app:tint="#8E8E9F"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvAdminItemSub1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="layzabhi20.01@gmail.com"
                    android:textColor="#8E8E9F"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Bar # Detail Row (Visible for Lawyers only) -->
            <LinearLayout
                android:id="@+id/layoutBarNumberRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_card_vector"
                    android:contentDescription="Bar Card Icon"
                    app:tint="#8E8E9F"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvAdminItemBarNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bar #: 2233028"
                    android:textColor="#8E8E9F"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- View Full Profile Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewFullProfile"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="VIEW FULL PROFILE"
            android:textColor="#FF8C00"
            android:textSize="12sp"
            android:textStyle="bold"
            app:strokeColor="#2E2E3E"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:layout_marginBottom="4dp"/>

        <!-- Quick actions/Approve button (Visible for pending actions) -->
        <LinearLayout
            android:id="@+id/layoutAdminActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminApprove"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="APPROVE PROFILE"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#30D158"
                app:cornerRadius="8dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
