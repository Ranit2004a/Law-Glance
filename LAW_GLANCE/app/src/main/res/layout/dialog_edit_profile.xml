<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161618">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:fontFamily="serif"
            android:layout_marginBottom="24dp"/>

        <!-- Profile Image Container -->
        <RelativeLayout
            android:id="@+id/layoutEditAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Circular Profile Image -->
            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="50dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2A1B0A">

                <ImageView
                    android:id="@+id/ivEditProfilePic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile_vector"
                    app:tint="#8E8E9F"
                    android:contentDescription="Profile Picture"/>
            </androidx.cardview.widget.CardView>

            <!-- Edit Camera overlay badge -->
            <androidx.cardview.widget.CardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FF9F0A">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera_vector" 
                    app:tint="#000000"
                    android:contentDescription="Camera Icon"/>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <!-- Name Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FULL NAME"
            android:textColor="#8E8E9F"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"/>

        <!-- Name EditText -->
        <EditText
            android:id="@+id/etEditProfileName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edittext_background"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A5A6A"
            android:hint="Enter your name"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"/>

        <!-- Phone Details Container -->
        <LinearLayout
            android:id="@+id/layoutPhoneDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHONE NUMBER"
                android:textColor="#8E8E9F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etEditProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_background"
                android:textColor="#FFFFFF"
                android:textColorHint="#5A5A6A"
                android:hint="Enter your phone number"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="phone"
                android:maxLines="1"
                android:layout_marginBottom="20dp"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <!-- Lawyer Details Container -->
        <LinearLayout
            android:id="@+id/layoutLawyerDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Specialization -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPECIALIZATION"
                android:textColor="#8E8E9F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etEditSpecialization"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_background"
                android:textColor="#FFFFFF"
                android:textColorHint="#5A5A6A"
                android:hint="e.g. Criminal Law"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="16dp"/>

            <!-- Experience -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPERIENCE (YEARS)"
                android:textColor="#8E8E9F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etEditExperience"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_background"
                android:textColor="#FFFFFF"
                android:textColorHint="#5A5A6A"
                android:hint="e.g. 5"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="number"
                android:maxLines="1"
                android:layout_marginBottom="16dp"/>

            <!-- City -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CITY"
                android:textColor="#8E8E9F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etEditCity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_background"
                android:textColor="#FFFFFF"
                android:textColorHint="#5A5A6A"
                android:hint="e.g. Mumbai"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="16dp"/>

            <!-- Fee -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSULTATION FEE (₹)"
                android:textColor="#8E8E9F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etEditFee"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_background"
                android:textColor="#FFFFFF"
                android:textColorHint="#5A5A6A"
                android:hint="e.g. 2000"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="number"
                android:maxLines="1"
                android:layout_marginBottom="16dp"/>

            <!-- Bar Council -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BAR COUNCIL NUMBER"
                android:textColor="#8E8E9F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etEditBarNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/edittext_background"
                android:textColor="#FFFFFF"
                android:textColorHint="#5A5A6A"
                android:hint="e.g. MAH/123/2020"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="16dp"/>

            <!-- About Me -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABOUT ME"
                android:textColor="#8E8E9F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etEditAbout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/edittext_background"
                android:textColor="#FFFFFF"
                android:textColorHint="#5A5A6A"
                android:hint="Tell clients about yourself..."
                android:textSize="15sp"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:maxLines="3"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEdit"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#8E8E9F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveEdit"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.5"
                android:text="SAVE CHANGES"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FF9F0A"
                app:cornerRadius="8dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
