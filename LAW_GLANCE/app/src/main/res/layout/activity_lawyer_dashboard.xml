<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0F0F15">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/lawyerTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#00000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="130dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/your_logo_image" />

        <!-- Notification Bell & Avatar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Notification Bell with Dot -->
            <RelativeLayout
                android:id="@+id/btnNotificationBell"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_bell_vector"
                    android:contentDescription="Notifications" />

                <!-- Bell Dot -->
                <View
                    android:id="@+id/viewBellDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#FF9F0A"
                    android:visibility="gone"/>
            </RelativeLayout>

            <!-- Profile Circle -->
            <androidx.cardview.widget.CardView
                android:id="@+id/lawyerProfileCard"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2A1B0A"
                android:clickable="true"
                android:focusable="true">
                
                <ImageView
                    android:id="@+id/ivLawyerProfilePic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Profile Picture"/>

                <TextView
                    android:id="@+id/tvLawyerInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="L"
                    android:textColor="#FF9F0A"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </RelativeLayout>

    <!-- CONTAINER 1: Home Dashboard Screen -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutLawyerHome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/lawyerTopBar"
        app:layout_constraintBottom_toTopOf="@id/lawyerBottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Welcome Greeting block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WELCOME BACK,"
                    android:textColor="#8E8E9F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/tvLawyerWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Adv. Name"
                    android:textColor="#FF9F0A"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"/>
            </LinearLayout>

            <!-- Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Left Card: Pending Requests -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardPendingRequests"
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/edittext_background"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <!-- Person Icon circular container -->
                    <RelativeLayout
                        android:id="@+id/layoutIconRequests"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#2D2114"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_people_vector"
                            app:tint="#FF9F0A"
                            android:contentDescription="People Icon"/>
                    </RelativeLayout>

                    <!-- NEW Badge -->
                    <TextView
                        android:id="@+id/tvCountInboundBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 NEW"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="@drawable/badge_pending"
                        android:backgroundTint="#FF9F0A"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/lblPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="#8E8E9F"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toTopOf="@id/lblRequests"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/lblRequests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requests"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Right Card: Today's Schedule -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardTodaySchedule"
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/edittext_background"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <!-- Clock Icon circular container -->
                    <RelativeLayout
                        android:id="@+id/layoutIconSchedule"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#141E30"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_clock"
                            app:tint="#0A84FF"
                            android:contentDescription="Clock Icon"/>
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/lblTodays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's"
                        android:textColor="#8E8E9F"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toTopOf="@id/lblSchedule"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/lblSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Schedule"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <!-- Tab Filter Pills -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/pillAllActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Activity"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/button_orange_border"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/pillRecentCases"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Recent Cases"
                    android:textColor="#8E8E9F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/edittext_background"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/pillArchives"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Archives"
                    android:textColor="#8E8E9F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/edittext_background"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- 1. Pending Requests Section -->
            <LinearLayout
                android:id="@+id/sectionPendingRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- Header with Orange Vertical Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="#FF9F0A"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending Requests"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:fontFamily="serif"/>
                </LinearLayout>

                <!-- Clickable Pending Requests Summary Card -->
                <RelativeLayout
                    android:id="@+id/cardPendingSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_background"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivPendingSummaryIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_empty_box_vector"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Pending Requests"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ivPendingSummaryIcon"
                        android:layout_toStartOf="@+id/ivPendingSummaryArrow"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tvPendingSummaryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No pending appointment requests"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvPendingSummarySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You're all caught up!"
                            android:textColor="#8E8E9F"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivPendingSummaryArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right_vector"
                        app:tint="#8E8E9F"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Arrow Right"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- 2. Today's Appointments Section -->
            <LinearLayout
                android:id="@+id/sectionTodayAppointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- Header with Green Vertical Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="#30D158"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Appointments"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:fontFamily="serif"/>
                </LinearLayout>

                <!-- Clickable Today's Appointments Summary Card -->
                <RelativeLayout
                    android:id="@+id/cardTodaySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_background"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ivTodaySummaryIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_calendar_check_vector"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Today's Appointments"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ivTodaySummaryIcon"
                        android:layout_toStartOf="@+id/ivTodaySummaryArrow"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="12dp"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tvTodaySummaryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No appointments scheduled for today"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvTodaySummarySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enjoy your free time!"
                            android:textColor="#8E8E9F"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivTodaySummaryArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right_vector"
                        app:tint="#8E8E9F"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Arrow Right"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- 3. Appointment History Section -->
            <LinearLayout
                android:id="@+id/sectionAppointmentHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Header with White Vertical Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="#FFFFFF"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Appointment History"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:fontFamily="serif"/>
                </LinearLayout>

                <!-- Recycler View -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <!-- View All History Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAllHistory"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_orange_border"
                    android:text="View All History"
                    android:textColor="#FF9F0A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_document_vector"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="#FF9F0A"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- CONTAINER 2: Calendar List Screen (hidden by default) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutLawyerCalendar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/lawyerTopBar"
        app:layout_constraintBottom_toTopOf="@id/lawyerBottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointments Schedule"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Overview of all scheduled/requested client sessions"
                android:textColor="#8E8E9F"
                android:textSize="13sp"
                android:layout_marginBottom="20dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCalendarList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- CONTAINER 3: Clients Contact List Screen (hidden by default) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutLawyerClients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/lawyerTopBar"
        app:layout_constraintBottom_toTopOf="@id/lawyerBottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Client Contacts"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Directory of clients who have booked sessions with you"
                android:textColor="#8E8E9F"
                android:textSize="13sp"
                android:layout_marginBottom="20dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerClientsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/lawyerBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#09090F"
        android:orientation="horizontal"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Bottom Nav: Home -->
        <LinearLayout
            android:id="@+id/navItemHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home_vector"
                android:contentDescription="Home Navigation"
                app:tint="#FF8C00"/>

            <TextView
                android:id="@+id/tvNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Home"
                android:textColor="#FF8C00"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Bottom Nav: Calendar -->
        <LinearLayout
            android:id="@+id/navItemCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivNavCalendar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar_vector"
                android:contentDescription="Calendar Navigation"
                app:tint="#8E8E9F"/>

            <TextView
                android:id="@+id/tvNavCalendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calendar"
                android:textColor="#8E8E9F"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Bottom Nav: Clients -->
        <LinearLayout
            android:id="@+id/navItemClients"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivNavClients"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_people_vector"
                android:contentDescription="Clients Navigation"
                app:tint="#8E8E9F"/>

            <TextView
                android:id="@+id/tvNavClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Clients"
                android:textColor="#8E8E9F"
                android:textSize="9sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
