<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/your_bg_img" />

    <!-- Dark gradient overlay for a modern, unified dark theme -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20F0F14" />

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#2D2D37"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Court Reminders Scheduler"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <!-- Scrollable container for input and list -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Input Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#CC1F1F2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="Add Case Reminder"
                          android:textColor="#FFFFFF"
                          android:textSize="17sp"
                          android:textStyle="bold"
                          android:layout_marginBottom="16dp"/>

                    <EditText
                        android:id="@+id/editCaseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Case Title (e.g. Land Dispute vs Sharma)"
                        android:textColorHint="#8E8E9F"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"
                        android:inputType="text"/>

                    <EditText
                        android:id="@+id/editCourtName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Court Name (e.g. District Court Room 4)"
                        android:textColorHint="#8E8E9F"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:inputType="text"/>

                    <!-- Date and Time select buttons side by side -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <Button
                            android:id="@+id/btnPickDate"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_picker_bg"
                            app:backgroundTint="@null"
                            android:text="Pick Date"
                            android:textColor="#FFFFFF"
                            android:drawableStart="@drawable/ic_calendar_vector"
                            android:drawablePadding="8dp"
                            android:paddingHorizontal="12dp"
                            android:gravity="center_vertical|center_horizontal"
                            android:layout_marginEnd="6dp"/>

                        <Button
                            android:id="@+id/btnPickTime"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_picker_bg"
                            app:backgroundTint="@null"
                            android:text="Pick Time"
                            android:textColor="#FFFFFF"
                            android:drawableStart="@drawable/ic_clock"
                            android:drawablePadding="8dp"
                            android:paddingHorizontal="12dp"
                            android:gravity="center_vertical|center_horizontal"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSaveReminder"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/button_background"
                        app:backgroundTint="@null"
                        android:text="SAVE REMINDER"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Reminders Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="Upcoming Hearings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- RecyclerView of Reminders -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
